module src/game/logic

import src/game/state

record Shipstorage(
  shipsPlayer: Int,
  shipsAI: Int
)

type Wincon {
  Win()
  Lose()
  InGame()
}

val spawnPlayer = 1
val spawnAI = 1
val spawnNeutral = 0

val battelstrngthPlayer = spawnAI + 1
val battelstrngthAI = spawnPlayer + 1
val battelstrngthNeutral = 0

// some default planets
val Planettest: Planet= Planet(id="-1", x=0, y=0, radius=0, shipsPlayer=0, shipsAI=0, owner=Neutral())
val Planet0: Planet= Planet(id="0", x=0, y=0, radius=100, shipsPlayer=49, shipsAI=0, owner=Player())
val Planet1: Planet= Planet(id="1", x=100, y=100, radius=100, shipsPlayer=0, shipsAI=100, owner=AI())
val freeforAI: Planet= Planet(id="2", x=100, y=100, radius=100, shipsPlayer=0, shipsAI=0, owner=Neutral())
val defaultPlanet: Planet = Planet(id="-1", x=0, y=0, radius=0, shipsPlayer=0, shipsAI=0, owner=Neutral())

// creating an inital GameState
def initialGameState(): GameState = {
  GameState(screen = Start(),
  planets = [Planet0, Planet1, freeforAI],
  selected = "")
}

// A Gamestate with a different map
def secondmap(): GameState = {
  GameState(screen = Start(),
  planets = [Planet0, Planet1, freeforAI, Planet(id="3", x=100, y=100, radius=100, shipsPlayer=0, shipsAI=0, owner=Neutral()), Planet(id="4", x=0, y=0, radius=100, shipsPlayer=49, shipsAI=0, owner=Player())],
  selected = "")
}

// adding Ships to a Planet
def addShipstoPlanet(p:Planet, o: Owner, s: Int): Planet = {
  o match{
    case Player() => {Planet(p.id, p.x, p.y, p.radius, addNotNegative(p.shipsPlayer, s), p.shipsAI, p.owner)}
    case AI() => {Planet(p.id, p.x, p.y, p.radius, p.shipsPlayer, addNotNegative(p.shipsAI, s), p.owner)}
    case Neutral() => {p}
  }
}

// updating the List of Planets
def updateListOfPlanets(l: List[Planet], p: Planet): List[Planet] = {
  var index = 0
  var target = -1
  l.foreach{x =>
  if(x.id == p.id){
    target = index
  }
  index = index + 1
  }
  if(target > -1){
    l.replace(target, p)
  } else {
    l
  }
}

// finding a Planet given an ID
def findPlanetbyID(planets: List[Planet], id: String): Planet = {
  var result: Planet = Planettest
  planets.foreach{x=>
  if(x.id == id){
    result = x
  }
  }
  result
}

// computing the half amount of the ships
def calculateHalfOfShips(ships: Int): Int = {
  if(ships.mod(2) == 0){
    ships / 2
  }else{
    (ships + 1) / 2
  }
}

// logic for updating planets
def calculatePlanetUpdate(p: Planet): Planet = {
  var result: Planet = p

  val SpawningShips: Shipstorage = calculateamountTSpawn(result)
  result = Planet(result.id, result.x, result.y, result.radius, result.shipsPlayer + SpawningShips.shipsPlayer, result.shipsAI + SpawningShips.shipsAI, result.owner)

  val shipsAfterBattle: Shipstorage= calculatebattel(result)
  result = Planet(result.id, result.x, result.y, result.radius, shipsAfterBattle.shipsPlayer, shipsAfterBattle.shipsAI, result.owner)

  val owner: Owner = changeownershipPlanet(result)
  // no longer returning a var
  Planet(result.id, result.x, result.y, result.radius, result.shipsPlayer, result.shipsAI, owner)
}

// computing the number of ships to spawn
def calculateamountTSpawn(p: Planet): Shipstorage = {
  val owner: Owner = p.owner
  owner match {
    case Player() => {Shipstorage(spawnPlayer, 0)}
    case AI() => {Shipstorage(0, spawnAI)}
    case Neutral() => {Shipstorage(0,0)}
  }
}

// computing the battles
def calculatebattel(p: Planet): Shipstorage = {
  var shipsPlayer: Int = p.shipsPlayer
  var shipsAI: Int = p.shipsAI
  if (shipsPlayer > 0 && shipsAI > 0){
    shipsPlayer = subtractionNotNegative(shipsPlayer, battelstrngthAI)
    shipsAI = subtractionNotNegative(shipsAI, battelstrngthPlayer)
  }
  Shipstorage(shipsPlayer, shipsAI)
}

// helper function
def subtractionNotNegative(ships: Int, amout: Int): Int = {
  if (ships > amout){
    ships - amout
  }else{
    0
  }
}

def addNotNegative(x: Int, y: Int): Int = {
  if(x + y < 0){
    0
  }else{
    x + y
  }
}

// changing the Owner of a Planet
def changeownershipPlanet(p: Planet): Owner = {
  val aIHasMoreShips: Bool = p.shipsPlayer == 0 && p.shipsAI > 0
  val playerHasMoreShips: Bool = p.shipsAI == 0 && p.shipsPlayer > 0

  if(playerHasMoreShips){
    Player()
  }else{
    if(aIHasMoreShips){
      AI()
    }else{
      p.owner
    }
  }
}

// checking the Wincondition
def checkWinOrLose(g: GameState): Wincon = {
  val planets: List[Planet] = g.planets
  var hasPlayerPlanets: Bool = false
  var hasAiPlanets: Bool = false

  planets.foreach{x=>
  val p: Planet = x
  if(isOwnedByPlayer(p)){
    hasPlayerPlanets = true
  }
  if(isOwnedByAI(p)){
    hasAiPlanets = true
  }
  }
  val hasWon: Bool = hasPlayerPlanets && not(hasAiPlanets)
  val hasLost: Bool = not(hasPlayerPlanets) && hasAiPlanets

  if(hasWon){
    Win() 
  }else{
    if(hasLost){
      Lose()
    }else{
      InGame()
    }
  }

}

// helper function to check the Owner of a Planet an help with readability
// removed var but kept for readability
def isOwnedByPlayer(p: Planet): Bool = {
  val owner : Owner = p.owner

  owner match {
    case Player() =>{true}
    case AI() =>{false}
    case Neutral() =>{false}
  }
}

def isOwnedByAI(p: Planet): Bool = {
  val owner : Owner = p.owner

  owner match {
    case Player() =>{false}
    case AI() =>{true}
    case Neutral() =>{false}
  }

}

def isOwnedByNeutral(p: Planet): Bool = {
  val owner : Owner = p.owner

  owner match {
    case Player() =>{false}
    case AI() =>{false}
    case Neutral() =>{true}
  }
}

// checking if an Owner is the Player
def isPlayerlogical(o: Owner): Bool = {
  o match {
    case Player() => true
    case _ => false
  }
}

// helping readabyility
def doNothing(): Unit = {}