module src/game/state

import io/console

type Screen {
  Start()
  Game()
  EndWin()
  EndLose()
}

type Owner {
  Player()
  AI()
  Neutral()
}

record Planet (
  id: String,
  x: Int,
  y: Int,
  radius: Int,
  shipsPlayer: Int,
  shipsAI: Int,
  owner: Owner
)

record GameState (
  screen: Screen,
  planets: List[Planet],
  selected: String
)

// returning the total number of Ships the Player has
// var is used to sum up
def shipsTotalPlayer(p: List[Planet]): Int = {
  var numShips: Int = 0
  p.foreach{x=>
  numShips = numShips + x.shipsPlayer
  }
  numShips
}

// returning the total number of Ships the Ai has
// var is used to sum up
def shipsTotalAi(p: List[Planet]): Int = {
  var numShips: Int = 0
  p.foreach{x=>
  numShips = numShips + x.shipsAI
  }
  numShips
}

// helper function for readability
def isSamePlanet(p1: Planet, p2: Planet): Bool = {
  p1.id == p2.id
}

// checking if a faction has more ships than the other faction
def hasMostShips(p: Planet, planets: List[Planet], o: Owner): Bool = {
  var shipsPlanet = 0
  var hasMostShips = true
  o match{
    case Player() =>{shipsPlanet = p.shipsPlayer}
    case AI() =>{shipsPlanet = p.shipsAI}
    case Neutral() =>{shipsPlanet = 0}
  }

  planets.foreach{x=>
  x.owner match{
    case Player() =>{if(shipsPlanet < x.shipsPlayer){hasMostShips = false}}
    case AI() =>{if(shipsPlanet < x.shipsAI){hasMostShips = false}}
    case Neutral() =>{hasMostShips = false}
  }
  }
  hasMostShips
}

// printing stuff for controlling 
def printGameState(gameState: GameState): Unit = {
  printScreeen(gameState.screen)
  printAllPlanets(gameState.planets)
  printSelectet(gameState.selected)
}

// printing the screens
def printScreeen(screen: Screen): Unit = screen match {
  case Start() => println("Start")
  case Game() => println("Game")
  case EndWin() => println("EndWin")
  case EndLose() => println("EndLose")
}

// printing the selected planet
def printSelectet(selected: String): Unit = {
  println("selected: " ++ selected)
}

// printing all planets
def printAllPlanets(planets : List[Planet]): Unit = {
  println("Now Printing Planets")
  planets.foreach {x=>
  printPlanet(x)
  }
  println("Printing Planets Done")
}
// printing a single planet
def printPlanet(planet: Planet): Unit = {
  println("planetID: " ++ planet.id)
  println("planetx: " ++ show(planet.x))
  println("planety: " ++ show(planet.y))
  println("planetradius: " ++ show(planet.radius))
  println("planetshipsPlayer: " ++ show(planet.shipsPlayer))
  println("planetIDshipsAI: " ++ show(planet.shipsAI))
  printOwner(planet.owner)
}
// printing the owner
def printOwner(owner: Owner) : Unit = owner match {
  case Player() => println("Owner: Player")
  case AI() => println("Owner: AI")
  case Neutral() => println("Owner: Neutral")
}
// some helper functions
def isStartscreen(s: Screen) : Bool = s match {
  case Start() => true
  case _ => false
}

def isGamescreen(s: Screen) : Bool = s match {
  case Game() => true
  case _ => false
}

def isGameOverscreen(s: Screen) : Bool = s match {
  case EndWin() => true
  case EndLose() => true
  case _ => false
}

def hasPlayerWon(s: Screen): Bool = {
  if(isGameOverscreen(s)){
    s match {
      case EndWin() => true
      case _ => false
    }
  }else{
    false
  }
}
// printing the start screen
def printStartscreen(mode: String): Unit = {
  line()
  center("PLANET CONQUEST " ++ mode)
  line()
  empty()
  println("s) start")
  println("r) return to main menu")
  println("q) quit")
  prompt()
}
// printing the main menu
def printMainMenu(): Unit = {
  line()
  center("PLANET CONQUEST")
  line()
  empty()
  println("n) normal game")
  println("a) ai game")
  println("p) PVP game")
  println("m) map editor")
  println("q) quit")
  prompt()
}
// helper functions for better formating
def line(): Unit = {
  println("==================================")
}

def empty(): Unit ={
  println("")
}
  
def center(text: String): Unit = {
  println("   " ++ text)
}
  
def prompt(): Unit ={
  println("")
  println("> ")
}

// print game state
def ownerName(o: Owner): String = {
  o match {
    case Player()  => "Player "
    case AI()      => "AI     "
    case Neutral() => "Ne}utral"
  }
}

// printing one row representing one planet
def planetRow(p: Planet, selected: String): String = {
  var mark = " "
  if(selected == p.id){
    mark = ">"
  }
  // pad für besseres formating
  mark ++
  " " ++ p.id ++
  " | " ++ ownerName(p.owner) ++
  " | " ++ show(p.shipsPlayer) ++
  " | " ++ show(p.shipsAI)
}
// printing the planets formated
def drawPlanets(planets: List[Planet], selected: String): Unit = {
  println(" ID | Owner   | Player |  AI")
  println("----+---------+--------+------")

  planets.foreach { p =>
    println(planetRow(p, selected))
  }
}
// printing the GameState
def drawGameState(state: GameState, p: Owner): Unit = {
  println("=====================================================")
  println(
    " TURN: " ++
    (if(isPlayer(p)){"Player"}  else {"AI"}) ++
    "        Selected: " ++ if(state.selected == ""){"None"}else{state.selected}
  )
  println("=====================================================")
  println("")
  drawPlanets(state.planets, state.selected)
  println("")
  println("Commands:")
  println("  to select type the <id>")
  println("  to undo select type nothing")
  println("return to main menu type r")
  println("  to end the game type q")
}

def isPlayer(p: Owner): Bool = p match {
  case Player()=> true
  case _ => false
}
// printing the move of the ai
def printAIMove(aiDidMove: Bool, from: String, to: String) = {
  if (not(aiDidMove)) {
    println("AI: holds position.")
  } else {
    println("AI: moves ships from Planet " ++ from ++ " to Planet " ++ to)
  }
}

// printing the end screen
def endScreen(playerWon: Bool) = {
  println("=====================================================")
  if(playerWon){
    println("                      YOU WIN                     ")
  }else{
    println("                      GAME OVER                     ")
  }
  println("=====================================================")
  println("")

  if(playerWon){
    println("You won! Congratulations!")
  }else{
    println("You lost! Better luck next time!")
  }
  println("")
  println("Press any key to return to the start screen...")}

  // printing the GameState for the Ai vs AI mode
  def drawGameStateAIvsAI(state: GameState): Unit = {
  println("=====================================================")
  println("                 AI vs AI SIMULATION")
  println("=====================================================")
  println("")

  drawPlanets(state.planets, "")

  println("")
  println("-----------------------------------------------------")
  println("Commands:")
  println("  r  - return to menu")
  println("  q  - quit to main menu")
  println("-----------------------------------------------------")
}

def ownerNamepvp(o: Owner): String =
  o match {
    case Player()  => "Player1"
    case AI()      => "Player2"
    case Neutral() => "Neutral"
  }

def planetRowpvp(p: Planet, selected: String): String = {
  var mark = " "
  if (selected == p.id) {
    mark = ">"
  }

  mark ++
  " " ++ show(p.id) ++
  " | " ++ ownerNamepvp(p.owner) ++
  " | " ++ show(p.shipsPlayer) ++
  " | " ++ show(p.shipsAI)
}

// printing the GameState for the PvP mode
def drawGameStatepvp(state: GameState, p: Owner): Unit = {
  println("=====================================================")
  println(
    " TURN: " ++
    (p match {
      case Player() => "Player1"
      case AI()     => "Player2"
      case _        => "?"
    }) ++
    "        Selected: " ++
    if (state.selected == "") {
      "None"
    }else {
      state.selected
    }
  )
  println("=====================================================")
  println("")

  drawPlanetspvp(state.planets, state.selected)

  println("")
  println("Commands:")
  println("  to select type the <id>")
  println("  to undo select type nothing")
  println("  return to main menu type r")
  println("  to end the game type q")
}

def drawPlanetspvp(planets: List[Planet], selected: String): Unit ={
  println(" ID | Owner   | Player |  Player2")
  println("----+---------+--------+------")

  planets.foreach { p =>
    println(planetRowpvp(p, selected))
  }}

