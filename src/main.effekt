module main // must be named same as the file!

import src/lib
import src/game/logic
import src/game/state
import src/effects/gamesate
import src/ffi/input
import src/game/ai


def main(): Unit = {
//console version
  mainMenu()

  println(helloWorld())
}

def mainMenu() : Unit = {
  var map: List[Planet] = initialGameState().planets
  try{
    while(true){
      printMainMenu()
      val input = getInput()
      input match {
        case "q" => do break(2)
        case "n" => consolegameloop()
        case "a" => aiVsAi()
        case "p" => pVP()
        case "m" => map = mapEditor(map)
        case _ => doNothing()
      }
    }
  }with Multibreak {
    def break(n) = {
      val numberOfBreaks: Int = n - 1
    }
  }
}

def mapEditor(map: List[Planet]): List[Planet]/Multibreak = {
  var result: List[Planet] = map
  try{
  while(true){
    drawMapEditorMenu()
    var input = getInput()
      input match {
        case "q" => do break(2)
        case "r" => do break(1)
        case "d" => result = initialGameState().planets
        case "s" => drawPlanets(result, "")
        case "e" => {
          var selected = ""
          try{
          while(true){
            drawMapEditMode(selected)
            input = getInput()
            input match{
              case "q" => do break(3)
              case "r" => do break(1)
              case "+1ai" => {if(selected != ""){result = updateListOfPlanets(result, addShipstoPlanet(findPlanetbyID(result,selected), AI(),1))}}
              case "+10ai" => {if(selected != ""){result = updateListOfPlanets(result, addShipstoPlanet(findPlanetbyID(result,selected), AI(),10))}}
              case "-1ai" => {if(selected != ""){result = updateListOfPlanets(result, addShipstoPlanet(findPlanetbyID(result,selected), AI(),-1))}}
              case "-10ai" => {if(selected != ""){result = updateListOfPlanets(result, addShipstoPlanet(findPlanetbyID(result,selected), AI(),-10))}}
              case "+1p" => {if(selected != ""){result = updateListOfPlanets(result, addShipstoPlanet(findPlanetbyID(result,selected), Player(),1))}}
              case "+10p" => {if(selected != ""){result = updateListOfPlanets(result, addShipstoPlanet(findPlanetbyID(result,selected), Player(),10))}}
              case "-1p" => {if(selected != ""){result = updateListOfPlanets(result, addShipstoPlanet(findPlanetbyID(result,selected), Player(),-1))}}
              case "-10p" => {if(selected != ""){result = updateListOfPlanets(result, addShipstoPlanet(findPlanetbyID(result,selected), Player(),-10))}}
              case _ => {
                var p: Planet = findPlanetbyID(result, input)
                if(p.id != "-1"){
                  selected = p.id
                  println("selected " ++ selected)
                }
                }
            }}
        }with Multibreak {
          def break(n) = {
            val numberOfBreaks: Int = n - 1
            if(numberOfBreaks > 0){
              do break(n)
            }
          }
        }
      }
      case _ => doNothing()
      }
  }
  }with Multibreak {
    def break(n) = {
      val numberOfBreaks: Int = n - 1
      if(numberOfBreaks > 0){
        do break(n)
      }
    }
  }
result
}


def consolegameloop() : Unit/Multibreak = {
  
  // some inital states
  var state: GameState = secondmap() //initialGameState()
  var planets:List[Planet] = state.planets

  // updateting planets using effects
  def planetschangable = new UpdatePlanets{
    def updatePlanet(planet: Planet) = {
      if(planet.id == ""){return ()}
    var index = 0
    var target = -1
    planets.foreach{x =>
    if(x.id == planet.id){
      target = index
    }
    index = index + 1
    }
    if(target > -1){
    planets = planets.replace(target, planet)}
    // for unit
    ()
    }
  }

  // updating gamestate using effects
  def gamesate = new UpdateGamestate{
    def changePlanets(p:List[Planet]) = {
      val newstate = GameState(
        screen = state.screen,
        planets = p,
        selected = state.selected)
      state = newstate
      ()
    }

    def cahngeSelected(s: String) = {
      val newstate = GameState(
        screen = state.screen,
        planets = state.planets,
        selected = s)
      state = newstate
      ()
    }

    def changeScreen(newScreen: Screen) = {
      val newstate = GameState(
        screen = newScreen,
        planets = state.planets,
        selected = state.selected)
      state = newstate
      ()
    }
    def getScreen() = {state.screen}
    def getGameState() = {state}
    def newGameState(g: GameState) ={
      state = g
    }
    def getPlanests() = {state.planets}
    def getSelected() = {state.selected}

  }

// actual loop
try{
  while(true){
    // managing the start screen
    if(isStartscreen(gamesate.getScreen())){
      printStartscreen("normal game")
      val input = getInput()
      input match{
        case "s" => gamesate.changeScreen(Game())
        case "q" => do break(2)
        case "r" => do break(1)
        case _ => ()
      }
    }

    // Game Loop
    if(isGamescreen(gamesate.getScreen())){

      // Player turn
      drawGameState(gamesate.getGameState(), Player())
      val input: String = getInputWithTimeout()
      input match {
        case "" => gamesate.cahngeSelected("")
        case "q" => do break(2)
        case "r" => do break(1)
        case _ => ()
      }
      val p: Planet = findPlanetbyID(planets, input)
      if(p.id != "-1"){
        if(gamesate.getSelected() == "" || gamesate.getSelected() == input){
          gamesate.cahngeSelected(input)
        }else{
          moveShips(findPlanetbyID(planets, gamesate.getSelected()), findPlanetbyID(planets, input), Player()){planetschangable}
          gamesate.cahngeSelected("")
        }
      }
      

      // AI turn
      val aimove:AIMovedecision = makeMoveDessision(gamesate.getGameState(), AI())
      val didMove: Bool = aimove.isturnUsed
      val from: String = aimove.move.from.id
      val to: String = aimove.move.to.id
      printAIMove(didMove, from, to)
      moveShips(findPlanetbyID(planets, from), findPlanetbyID(planets, to), AI()){planetschangable}
      
      // updating the game
      updatePlanets(planets){planetschangable}
      updateGamestate(planets){gamesate}
      applyWinCon(state){gamesate}
    }

    if(isGameOverscreen(gamesate.getScreen())){
      val hasPlayerWon: Bool = hasPlayerWon(gamesate.getScreen())
      endScreen(hasPlayerWon)
      val input: String = getInput()
      input match{
        case _ => {
          gamesate.newGameState(initialGameState())
          do break(1)
        }
      }
    }
  }
  }with Multibreak {
    def break(n) = {
      val numberOfBreaks: Int = n - 1
      if(numberOfBreaks > 0){
        do break(n)
      }
    }
  }
}
